# RVR Inc Environment Variables
# Copy this file to .env.local and fill in the values

# Stitch MCP API Key
STITCH_API_KEY=your_key_here

# Vercel Configuration
VERCEL_TOKEN=your_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email (SMTP)
SMTP_HOST=mail.roetsvanrensburg.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@roetsvanrensburg.co.za
SMTP_FROM_NAME=RVR Inc. Attorneys
ADMIN_NOTIFICATION_EMAIL=admin@rvrinc.co.za

# Site URL
NEXT_PUBLIC_SITE_URL=https://rvrinc.co.za
