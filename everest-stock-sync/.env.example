# --- Supabase (REQUIRED for the agent/dashboard: reads the stock list) ---
# On a standalone client PC these must be set here (there's no everest-motoring
# repo next door to fall back to). Get them from the everest-motoring project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- cars.co.za dealer portal credentials (only for the standalone headless
#     spike; the agent uses your live Chrome login instead, so leave blank) ---
CARSCOZA_USERNAME=
CARSCOZA_PASSWORD=

# URL of the dealer login page. Set this to the real dealer-portal login URL.
CARSCOZA_LOGIN_URL=

# URL of the page that lists your current live stock (once logged in).
# Leave blank for the first run — the spike will pause on the post-login page
# so you can navigate manually and copy the stock-list URL.
CARSCOZA_STOCK_URL=

# --- runtime ---
# Run with a visible browser window (true) or headless (false). Start with true.
HEADLESS=false

# Optional: Slack/Telegram/Discord incoming-webhook URL for failure alerts.
# Leave blank to just log alerts to the console.
ALERT_WEBHOOK_URL=
