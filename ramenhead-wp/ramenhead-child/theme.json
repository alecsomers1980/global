{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "palette": [
                { "slug": "rh-bg",       "name": "Ramen Black",  "color": "#000000" },
                { "slug": "rh-bg-alt",   "name": "Smoke",        "color": "#0a0a0a" },
                { "slug": "rh-fg",       "name": "Cream",        "color": "#ebe3d7" },
                { "slug": "rh-fg-muted", "name": "Ash",          "color": "#a6a39f" },
                { "slug": "rh-accent",   "name": "Tonkotsu Red", "color": "#EE3526" }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "slug": "poppins",
                    "name": "Poppins",
                    "fontFamily": "Poppins, system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--rh-bg)",
            "text": "var(--wp--preset--color--rh-fg-muted)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--poppins)"
        }
    }
}
