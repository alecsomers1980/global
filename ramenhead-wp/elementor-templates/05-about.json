            {
              "id": "tx03a1bc",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Ramenhead has imported the only Yamato noodle machine in Africa, producing every noodle in-house. It makes the restaurant a genuinely one-of-a-kind proposition — each bowl begins with silky, freshly-made noodles you won't find anywhere else on the continent.</p>",
                "text_color": "#a6a39f",
                "typography_typography": "custom",
