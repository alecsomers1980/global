NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Migrations only (npm run migrate). Supabase dashboard: Connect > Session pooler.
# Carries the database password — never commit a filled-in value.
SUPABASE_DB_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# PayFast — PayFast's PUBLIC SANDBOX credentials, correct as-is for testing.
# The passphrase is NOT optional: the shared sandbox merchant has one set, and
# leaving it blank gets every transaction rejected with "Generated signature
# does not match submitted signature" — which reads like a code bug and is not.
# Replace all three with the live merchant values at handover and set
# PAYFAST_MODE=production (the live passphrase is whatever the client has
# configured on their own PayFast account, and may legitimately be empty).
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_MODE=sandbox

# Email
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=friedsgrobler@gmail.com
