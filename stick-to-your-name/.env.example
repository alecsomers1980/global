# PayFast (https://www.payfast.co.za)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Public URL of this site (must match what PayFast sees)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Postgres / Neon connection (set via Vercel dashboard in prod)
POSTGRES_URL=

# Admin session signing
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin — used ONLY on first run to create the admin_users row.
# After first run the password is managed in the database (forgot-password flow).
ADMIN_EMAIL=melissa@aloesigns.co.za
# bcrypt hash of the password — generate with: node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH=

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=
EMAIL_FROM=noreply@sticktoyourname.co.za
EMAIL_ADMIN=melissa@aloesigns.co.za

# Vercel Blob (design image uploads)
BLOB_READ_WRITE_TOKEN=
